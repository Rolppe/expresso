# Template for pico/secrets.py. Copy this file to pico/secrets.py and fill in your own values.
# pico/secrets.py is listed in .gitignore and must never be committed.
#
# Which file reads which key:
#   main.py   : ssid, password                                      (imported at start-up: `from secrets import ssid, password`)
#   ugit.py   : ssid, password, github_user, github_repo, github_token
#               (over-the-air update helper; not used by main.py, see "Status and limitations" in README.md)
#
# diagnet.py prefers a second, optional file diag_wifi.py (also ignored by git) with its own `ssid` and
# `password` when it exists on the Pico; if it does not, the values below are used.

ssid = 'your-wifi-name'
password = 'your-wifi-password'

# Only needed by ugit.py. Leave github_token as '' for a public repository (ugit.py only
# sends the Authorization header when the token is not empty).
github_user = 'your-github-user'
github_repo = 'your-github-repo'
github_token = ''
