# Copy to local.env (not in the repository) and set your own values. Read by pico_dev.py,
# build_set.py, diagnet/keraaja.py and the hardware scripts in testit/ and scale/testit/.
# Variables already set in the environment win. 192.0.2.x are RFC 5737 example addresses.
PICO_LINK=zero
PICO_ZERO=192.0.2.10
PICO_PHONE=192.0.2.11:5555
#PICO_ADB=/path/to/adb
PICO_CHARGER_CYCLE=0
PICO_CHARGER_ENTITY=switch.shellyplus1pm_example
HA_URL=http://192.0.2.12:8123
#HA_TOKEN_FILE=~/.config/ha/token
